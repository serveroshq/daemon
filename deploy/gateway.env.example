# /etc/serveros/gateway.env  (chmod 600, owned by serveros-gateway)
GATEWAY_LISTEN=0.0.0.0:8443
GATEWAY_INTERNAL=127.0.0.1:8090
GATEWAY_CA=/etc/serveros/ca.crt
GATEWAY_CERT=/etc/serveros/gateway.crt
GATEWAY_KEY=/etc/serveros/gateway.key
GATEWAY_PANEL_URL=https://serveros.com
# Same value as DAEMON_GATEWAY_SECRET in the panel's .env
GATEWAY_SECRET=
# Only for a panel whose certificate the public web PKI does not vouch for
# GATEWAY_PANEL_CA=/etc/serveros/panel-ca.pem
RUST_LOG=info
